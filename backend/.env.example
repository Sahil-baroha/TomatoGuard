# TomatoGuard AI — Backend environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to the repository.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=

# ── Cloudinary (Phase 3 — disease image uploads) ─────────────────────────────
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── OpenWeatherMap (Phase 5) ──────────────────────────────────────────────────
OPENWEATHERMAP_API_KEY=

# ── Admin scraper bot (Phase 8) ───────────────────────────────────────────────
ADMIN_BOT_EMAIL=
ADMIN_BOT_PASSWORD=
GEMINI_KEY=